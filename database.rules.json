{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$pin": {
        ".read": "auth != null && data.child('meta/hostUid').val() === auth.uid",
        ".write": "auth != null && data.child('meta/hostUid').val() === auth.uid",

        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['hostUid', 'created', 'status']) && newData.child('hostUid').isString()"
        },

        "host": {
          ".read": "auth != null"
        },

        "lobby": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($pin).child('meta/status').val() === 'lobby' && !root.child('rooms').child($pin).child('kicked').child($uid).exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && (!newData.child('color').exists() || newData.parent().parent().child('colors').child(newData.child('color').val()).val() === $uid)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "color": {
              ".validate": "newData.isString()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "colors": {
          ".read": "auth != null",
          "$color": {
            ".write": "auth != null && root.child('rooms').child($pin).child('meta/status').val() === 'lobby' && !root.child('rooms').child($pin).child('kicked').child(auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
            ".validate": "$color.matches(/^(red|blue|white|orange|green|purple)$/) && newData.parent().parent().child('lobby').child(auth.uid).exists()"
          }
        },

        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($pin).child('meta').exists()",
            ".validate": "newData.hasChildren(['online', 'changedAt']) && newData.child('online').isBoolean()"
          }
        },

        "kicked": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },

        "actions": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($pin).child('public/players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'action', 'at']) && newData.child('at').val() === now"
          }
        },

        "results": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },

        "public": {
          ".read": "auth != null"
        },

        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
